\newlabel{tab:ch5_baseline}{{5.1}{37}{Baseline ResNet18 Performance on PathMNIST Test Set ($N = 7{,}180$)}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Normalised confusion matrix for ResNet18 on PathMNIST test set. Strong diagonal dominance indicates reliable per-class predictions. Primary confusions occur between morphologically similar small-cell classes (Mitoses/Lymphocytes and Monocytes/Neutrophils).}}{38}{figure.caption.10}\protected@file@percent }
\newlabel{fig:confusion_matrix}{{5.1}{38}{Normalised confusion matrix for ResNet18 on PathMNIST test set. Strong diagonal dominance indicates reliable per-class predictions. Primary confusions occur between morphologically similar small-cell classes (Mitoses/Lymphocytes and Monocytes/Neutrophils)}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.2}Model Comparison: ResNet18 vs. DenseNet121 vs. EfficientNet-B3 vs. ViT-Small}{38}{section.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.2}{\ignorespaces Architecture Comparison on PathMNIST Test Set}}{38}{table.caption.11}\protected@file@percent }
\newlabel{tab:ch5_model_comparison}{{5.2}{38}{Architecture Comparison on PathMNIST Test Set}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces (a) Classification performance of four architectures on PathMNIST test set. EfficientNet-B3 achieves the highest accuracy (91.38\%), balanced accuracy (89.02\%), and F1 (91.35\%). (b) Parameter counts; ViT-Small is the largest model despite not being the best performer, reflecting its requirement for larger datasets.}}{39}{figure.caption.12}\protected@file@percent }
\newlabel{fig:ch5_model_comparison}{{5.2}{39}{(a) Classification performance of four architectures on PathMNIST test set. EfficientNet-B3 achieves the highest accuracy (91.38\%), balanced accuracy (89.02\%), and F1 (91.35\%). (b) Parameter counts; ViT-Small is the largest model despite not being the best performer, reflecting its requirement for larger datasets}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.3}Uncertainty Estimation Analysis (MC Dropout)}{39}{section.5.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3.1}Uncertainty Distribution Statistics}{39}{subsection.5.3.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces MC Dropout Uncertainty Distribution Statistics — PathMNIST Test Set}}{39}{table.caption.13}\protected@file@percent }
\newlabel{tab:ch5_unc_stats}{{5.3}{39}{MC Dropout Uncertainty Distribution Statistics — PathMNIST Test Set}{table.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3.2}Uncertainty-Error Correlation}{40}{subsection.5.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.4}{\ignorespaces Uncertainty-Error Correlation Analysis — PathMNIST}}{40}{table.caption.14}\protected@file@percent }
\newlabel{tab:ch5_unc_corr}{{5.4}{40}{Uncertainty-Error Correlation Analysis — PathMNIST}{table.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces (a) Uncertainty distributions for correct and incorrect predictions. Incorrect predictions are shifted towards higher entropy, with substantial overlap indicating that some errors occur at low uncertainty. The vertical dashed line marks the accuracy-optimal threshold $\tau = 0.4916$. (b) Per-bin error rate increases monotonically with predictive entropy, confirming that higher uncertainty reliably indicates higher error risk.}}{40}{figure.caption.15}\protected@file@percent }
\newlabel{fig:ch5_uncertainty_dist}{{5.3}{40}{(a) Uncertainty distributions for correct and incorrect predictions. Incorrect predictions are shifted towards higher entropy, with substantial overlap indicating that some errors occur at low uncertainty. The vertical dashed line marks the accuracy-optimal threshold $\tau = 0.4916$. (b) Per-bin error rate increases monotonically with predictive entropy, confirming that higher uncertainty reliably indicates higher error risk}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.4}Deep Ensemble Uncertainty vs. MC Dropout}{41}{section.5.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.5}{\ignorespaces MC Dropout vs. Deep Ensemble — PathMNIST Test Set}}{41}{table.caption.16}\protected@file@percent }
\newlabel{tab:ch5_ens_vs_mc}{{5.5}{41}{MC Dropout vs. Deep Ensemble — PathMNIST Test Set}{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Comparison of MC Dropout and Deep Ensemble across five normalised metrics. Deep ensembles outperform MC Dropout on all uncertainty quality metrics (AUROC, $r_{pb}$, $\rho _s$) and calibration (1$-$ECE), but at a 5$\times $ inference cost. Raw values are annotated above each bar.}}{41}{figure.caption.17}\protected@file@percent }
\newlabel{fig:ch5_ensemble_vs_mcdropout}{{5.4}{41}{Comparison of MC Dropout and Deep Ensemble across five normalised metrics. Deep ensembles outperform MC Dropout on all uncertainty quality metrics (AUROC, $r_{pb}$, $\rho _s$) and calibration (1$-$ECE), but at a 5$\times $ inference cost. Raw values are annotated above each bar}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.5}Calibration Analysis (ECE, MCE, Reliability Diagrams)}{42}{section.5.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5.1}Pre-Calibration Overconfidence}{42}{subsection.5.5.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.6}{\ignorespaces Calibration Metrics Before and After Temperature Scaling — PathMNIST (ResNet18)}}{42}{table.caption.18}\protected@file@percent }
\newlabel{tab:ch5_calibration}{{5.6}{42}{Calibration Metrics Before and After Temperature Scaling — PathMNIST (ResNet18)}{table.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5.2}Effect of Temperature Scaling on Triage}{42}{subsection.5.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces Reliability diagrams before and after temperature scaling. (a) Before scaling, the model is systematically overconfident: empirical accuracy (bars) falls below the perfect calibration diagonal (dashed) in high-confidence bins. (b) After temperature scaling with $T^* = 1.42$, calibration improves substantially (ECE reduced from 0.087 to 0.031), and the reliability curve aligns closely with the diagonal.}}{42}{figure.caption.19}\protected@file@percent }
\newlabel{fig:ch5_calibration}{{5.5}{42}{Reliability diagrams before and after temperature scaling. (a) Before scaling, the model is systematically overconfident: empirical accuracy (bars) falls below the perfect calibration diagonal (dashed) in high-confidence bins. (b) After temperature scaling with $T^* = 1.42$, calibration improves substantially (ECE reduced from 0.087 to 0.031), and the reliability curve aligns closely with the diagonal}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.6}Triage System Optimisation — PathMNIST}{43}{section.5.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6.1}Threshold Sweep Results}{43}{subsection.5.6.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.7}{\ignorespaces Optimal Triage Threshold Configurations — PathMNIST (ResNet18, $p_h = 0.95$)}}{43}{table.caption.20}\protected@file@percent }
\newlabel{tab:ch5_triage_thresholds}{{5.7}{43}{Optimal Triage Threshold Configurations — PathMNIST (ResNet18, $p_h = 0.95$)}{table.caption.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6.2}Human Accuracy Sensitivity Analysis}{43}{subsection.5.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces (a) System accuracy versus automation rate across the threshold sweep (ResNet18, $p_h = 0.95$). Peak accuracy of 97.35\% occurs at automation rate 63.9\%, corresponding to threshold $\tau = 0.4916$. (b) Total cost versus uncertainty threshold. The cost-minimising threshold ($\tau = 0.4159$) achieves \$6,798 total cost versus \$78,700 for AI-only, but at a 91.9\% deferral rate.}}{44}{figure.caption.21}\protected@file@percent }
\newlabel{fig:ch5_triage_sweep}{{5.6}{44}{(a) System accuracy versus automation rate across the threshold sweep (ResNet18, $p_h = 0.95$). Peak accuracy of 97.35\% occurs at automation rate 63.9\%, corresponding to threshold $\tau = 0.4916$. (b) Total cost versus uncertainty threshold. The cost-minimising threshold ($\tau = 0.4159$) achieves \$6,798 total cost versus \$78,700 for AI-only, but at a 91.9\% deferral rate}{figure.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.8}{\ignorespaces System Performance Across Human Accuracy Levels ($\tau = 0.4916$, PathMNIST)}}{44}{table.caption.22}\protected@file@percent }
\newlabel{tab:ch5_human_sensitivity}{{5.8}{44}{System Performance Across Human Accuracy Levels ($\tau = 0.4916$, PathMNIST)}{table.caption.22}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.7}Cross-Dataset Generalisation (ChestMNIST, DermaMNIST)}{44}{section.5.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces System accuracy as a function of simulated human reviewer accuracy at the accuracy-optimal threshold ($\tau = 0.4916$). The shaded area represents the triage improvement over the AI-only baseline (89.04\%). The system benefits from triage at all evaluated human accuracy levels, including when human accuracy (80\%) is below the AI baseline.}}{45}{figure.caption.23}\protected@file@percent }
\newlabel{fig:ch5_human_sensitivity}{{5.7}{45}{System accuracy as a function of simulated human reviewer accuracy at the accuracy-optimal threshold ($\tau = 0.4916$). The shaded area represents the triage improvement over the AI-only baseline (89.04\%). The system benefits from triage at all evaluated human accuracy levels, including when human accuracy (80\%) is below the AI baseline}{figure.caption.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.9}{\ignorespaces Cross-Dataset Triage Performance ($p_h = 0.95$)}}{45}{table.caption.24}\protected@file@percent }
\newlabel{tab:ch5_crossdataset}{{5.9}{45}{Cross-Dataset Triage Performance ($p_h = 0.95$)}{table.caption.24}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.8}Interpretability Results — Grad-CAM Visualisations}{45}{section.5.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.8.1}PathMNIST Grad-CAM Analysis}{45}{subsection.5.8.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.8}{\ignorespaces (a) Baseline and triage system accuracy across three MedMNIST datasets. Triage consistently improves over the baseline on all datasets, with larger absolute gains on harder tasks (DermaMNIST). (b) Automation rates are broadly consistent (58--64\%), indicating that the proportion of confidently classifiable cases is similar across imaging modalities.}}{46}{figure.caption.25}\protected@file@percent }
\newlabel{fig:ch5_crossdataset}{{5.8}{46}{(a) Baseline and triage system accuracy across three MedMNIST datasets. Triage consistently improves over the baseline on all datasets, with larger absolute gains on harder tasks (DermaMNIST). (b) Automation rates are broadly consistent (58--64\%), indicating that the proportion of confidently classifiable cases is similar across imaging modalities}{figure.caption.25}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.8.2}DermaMNIST Grad-CAM Analysis}{46}{subsection.5.8.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5.9}Robustness Analysis (Noise, Distribution Shift)}{47}{section.5.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.9.1}Additive Gaussian Noise}{47}{subsection.5.9.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.10}{\ignorespaces Accuracy and Uncertainty Under Additive Gaussian Noise — PathMNIST (ResNet18)}}{47}{table.caption.26}\protected@file@percent }
\newlabel{tab:ch5_robustness}{{5.10}{47}{Accuracy and Uncertainty Under Additive Gaussian Noise — PathMNIST (ResNet18)}{table.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.9}{\ignorespaces (a) AI-only accuracy and triage system accuracy under increasing Gaussian noise. The triage system degrades more gracefully than AI-only at all noise levels, maintaining a positive gap throughout. (b) Mean predictive entropy increases monotonically with noise $\sigma $, confirming that MC Dropout uncertainty correctly detects distribution shift: as images become more corrupted, the model appropriately defers more cases to human review.}}{47}{figure.caption.27}\protected@file@percent }
\newlabel{fig:ch5_robustness}{{5.9}{47}{(a) AI-only accuracy and triage system accuracy under increasing Gaussian noise. The triage system degrades more gracefully than AI-only at all noise levels, maintaining a positive gap throughout. (b) Mean predictive entropy increases monotonically with noise $\sigma $, confirming that MC Dropout uncertainty correctly detects distribution shift: as images become more corrupted, the model appropriately defers more cases to human review}{figure.caption.27}{}}
